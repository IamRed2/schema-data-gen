{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": ["refund", "delivery"]
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "description": "고객이 상담팀에 보낸 문의. category에 해당하는 구체적인 문제와 원하는 조치를 한 문장으로 작성한다."
    }
  },
  "required": ["category", "message"],
  "additionalProperties": false
}
