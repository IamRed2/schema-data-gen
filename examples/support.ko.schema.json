{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": ["refund", "delivery"]
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "description": "고객 문의 본문. category에 해당하는 문제와 고객이 요청한 조치를 포함합니다."
    }
  },
  "required": ["category", "message"],
  "additionalProperties": false
}
