{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": ["refund", "delivery"]
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "description": "Customer support message containing the issue in the selected category and the customer's requested resolution."
    }
  },
  "required": ["category", "message"],
  "additionalProperties": false
}
