{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {"type": "string"},
    "age": {"type": "integer", "minimum": 18, "maximum": 90},
    "occupation": {
      "type": "string",
      "description": "프로필에 표시되는 직업명."
    },
    "introduction": {
      "type": "string",
      "description": "프로필에 표시되는 한 문장 자기소개. 이름과 직업을 포함합니다."
    }
  },
  "required": ["name", "age", "occupation", "introduction"],
  "additionalProperties": false
}
